{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm --prefix web/app ci",
  "buildCommand": "npm --prefix web/app run build",
  "outputDirectory": "web/app/dist",
  "github": { "silent": true },
  "rewrites": [{ "source": "/app", "destination": "/app.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
