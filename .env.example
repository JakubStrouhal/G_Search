# Environment template — committed. Real values live in .env.local, which is gitignored.
#
# Copy the frontend block into web/app/.env.local once the Vue app is scaffolded
# (005-stack-init step 6). Vite reads .env.local from its own root, not from here.
#
# Confirm the local values at any time with:  npx supabase status

# --- LOCAL Supabase stack ------------------------------------------------------
# Not secrets. Read the real values out of `npx supabase status`.
#
# Use the PUBLISHABLE key in the browser, not the legacy anon key — Supabase's own
# skill (.claude/skills/supabase/SKILL.md) states anon keys are compatibility-only.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side only, for the offline seed/embedding scripts. No VITE_ prefix, ever.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- REMOTE (prod) project -----------------------------------------------------
# Filled in only after `npx supabase link --project-ref <ref>` (005-stack-init step 5,
# gated on the owner naming the project). Real values NEVER get committed.
#
# Two rules that matter here:
#   1. Anything VITE_-prefixed is compiled into the browser bundle. The service-role /
#      secret key must never carry that prefix, and never reaches the frontend at all.
#   2. Mutating SQL against the remote project needs explicit per-run approval.
#
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
